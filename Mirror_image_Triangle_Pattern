n = int(input("Enter your number: "))

row = n
while(row > 1):
  

  #space
  
  col = 1
  while(col <= n - row):
    print(" ", end = " ")
    col += 1

    #stars
  col = 1
  while(col <= row):
    print("*  ", end = " ")
    col += 1

  row -= 1
  print()


