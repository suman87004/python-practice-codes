n = int(input("Enter your pattern number: "))
row = 1

while(row < n):
  col = 1
  while(col <= n - row):
    print(" ", end = " ")
    col += 1

  col = 1
  while(col <= row):
    print("*  ", end = " ")
    col += 1
    
  row += 1
  print()



row = n

while(row >= 1):
  col = 1
  while(col <= n - row):
    print(" ", end = " ")
    col += 1

  col = 1
  while(col <= row):
    print("*  ", end = " ")
    col += 1
    
  row -= 1
  print()
